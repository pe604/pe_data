// Niveshaay Deal Pipeline: data model (SPEC §4).
// Status: proposed in Prompt 0, pending approval. Migrations are created in Phase 1.
//
// Conventions
// - ids are cuid strings.
// - Calendar dates (dateReceived, exitAt) are @db.Date and mean the date in Asia/Kolkata.
// - Timestamps are timestamptz.
// - Enum values are UPPER_SNAKE in the DB; UI labels live in src/lib/domain/labels.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// Connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// No Viewer role for now (decided 2026-09-28): every signed-in domain user is at least an Editor.
enum Role {
  ADMIN
  EDITOR
}

/// Order matters: it is the pipeline order (SPEC §4).
enum Stage {
  NOT_ASSIGNED
  CALL_PENDING
  INTERNAL_DISCUSSION
  SCUTTLEBUTT
  ALLOCATION
  DUE_DILIGENCE
}

enum CompanyStatus {
  PIPELINE
  REJECTED
  INVESTED
}

enum PersonRole {
  PE
  RESEARCH
  VIA
}

enum FileKind {
  DECK
  MODEL
  OTHER
  MIS
  RESULT_NOTE
}

enum SummaryJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum SummaryJobStep {
  READING
  WRITING
}

// ─── People ──────────────────────────────────────────────────────────────────

/// A signed-in person. Created or updated on each sign-in (JWT sessions, no Auth.js adapter tables).
/// `role` is informational; the effective role comes from src/lib/auth/session.ts (no login yet: shared "Team" Editor).
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique // stored lower-case
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())

  companiesCreated  Company[]      @relation("CompanyCreatedBy")
  comments          Comment[]
  filesUploaded     File[]
  summariesCreated  Summary[]      @relation("SummaryCreatedBy")
  summariesEdited   Summary[]      @relation("SummaryEditedBy")
  summaryJobs       SummaryJob[]
  rejections        Rejection[]
  auditLogs         AuditLog[]
  deletionLogs      DeletionLog[]
  roundsCreated     InvestmentRound[]
  meetingsCreated   Meeting[]
  updatesAdded      CompanyUpdate[]
  misEntered        MisFigure[]
}

/// Names used in PE / Research / Via chips. Not necessarily app users.
model TeamMember {
  id      String @id @default(cuid())
  name    String // Title Case, as displayed
  /// lower-case, trimmed, single-spaced copy of `name`. Enforces case-insensitive uniqueness.
  nameKey String @unique
  /// Non-null = shown in the PE team bar, ascending. Set automatically when the name is newly assigned as PE.
  peRank  Int?
  /// Which name lists this person is in (separate autofill pools). Via suggests PE + Via names.
  inPe       Boolean @default(false)
  inResearch Boolean @default(false)
  inVia      Boolean @default(false)
  /// Digits only, with country code (e.g. 9198xxxxxxxx). Used to recognise WhatsApp senders (SPEC §14).
  whatsappNumber String? @unique
  /// Idle deal reminders on WhatsApp (SPEC §15.7).
  remindersOn    Boolean @default(true)
  /// Sub-team within Research (SPEC §15.9): "SCUTTLEBUTT" or null. Assigned through Assigned Research; no own column.
  team           String?
  /// Head of `team`: told on WhatsApp (with the deck) when a member of the team is assigned a company. One per team.
  teamHead       Boolean @default(false)

  assignments CompanyPerson[]
  reminders   ReminderLog[]

  @@index([peRank])
}

// ─── Companies ───────────────────────────────────────────────────────────────

model Company {
  id String @id @default(cuid())

  // Core
  name      String
  sectorId  String?
  sector    Sector? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  subSector String?
  stage     Stage   @default(NOT_ASSIGNED)
  /// 1–5, null = unset. CHECK (priority BETWEEN 1 AND 5) added in the migration SQL.
  priority  Int?

  // Status and dates
  status         CompanyStatus @default(PIPELINE)
  dateReceived   DateTime?     @db.Date
  exitAt         DateTime?     @db.Date
  exitStage      Stage?
  directInvested Boolean       @default(false)

  // Other
  rejectReason    String?
  oneDriveUrl     String? // only http/https, validated on write
  activeSummaryId String?  @unique
  activeSummary   Summary? @relation("ActiveSummary", fields: [activeSummaryId], references: [id], onDelete: SetNull)

  // Edit flags: true once a person has changed the AI-filled value
  nameEdited      Boolean @default(false)
  sectorEdited    Boolean @default(false)
  subSectorEdited Boolean @default(false)

  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("CompanyCreatedBy", fields: [createdById], references: [id])

  people      CompanyPerson[]
  comments    Comment[]
  files       File[]
  summaries   Summary[]       @relation("CompanySummaries")
  summaryJobs SummaryJob[]
  rejections  Rejection[]
  auditLogs   AuditLog[]
  rounds      InvestmentRound[]
  contacts    CompanyContact[]
  updates     CompanyUpdate[]
  checks      QuarterCheck[]
  meetings    Meeting[]
  misFigures  MisFigure[]
  reminders   ReminderLog[]
  newsWatch   NewsWatch?
  newsItems   NewsItem[]

  @@index([status])
  @@index([status, priority, dateReceived])
}

/// PE / Research / Via assignments. Order within (company, role) is `position`.
model CompanyPerson {
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)
  role         PersonRole
  position     Int

  @@id([companyId, role, teamMemberId])
  @@index([teamMemberId, role])
}

model Comment {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  text      String
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([companyId, createdAt])
}

/// Stored via StorageDriver under a random `storageKey`; the original name is never used on disk.
/// `companyId` is null only while a deck is staged in the Add company modal (see phase plan, risk R3).
model File {
  id           String   @id @default(cuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originalName String
  kind         FileKind
  mime         String   // sniffed, not client-supplied
  sizeBytes    Int
  storageKey   String   @unique
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())
  /// MIS and result-note files: the FY quarter they are for, e.g. "FY27-Q2".
  quarter      String?

  summaries   Summary[]
  summaryJobs SummaryJob[]
  misFigures  MisFigure[]

  @@index([companyId, uploadedAt])
  @@index([companyId, kind])
  @@index([companyId, quarter])
}

// ─── AI summaries ────────────────────────────────────────────────────────────

/// One row per successful generation. Failed or cancelled runs never create a version.
model Summary {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation("CompanySummaries", fields: [companyId], references: [id], onDelete: Cascade)
  version        Int
  sourceFileId   String?
  sourceFile     File?    @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  /// Kept so "Version N, from <file>" still reads correctly after the file is removed.
  sourceFileName String?
  json           Json? // raw validated AI output; null for a hand-written summary
  markdown       String
  edited         Boolean   @default(false)
  editedById     String?
  editedBy       User?     @relation("SummaryEditedBy", fields: [editedById], references: [id])
  editedAt       DateTime?
  createdById    String
  createdBy      User      @relation("SummaryCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())

  activeFor Company? @relation("ActiveSummary")

  @@unique([companyId, version])
}

/// Background generation job (SPEC §9.1). Survives a closed tab and a server restart.
/// `companyId` is null while running for a deck staged in the Add company modal.
model SummaryJob {
  id           String           @id @default(cuid())
  companyId    String?
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceFileId String?
  sourceFile   File?            @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  status       SummaryJobStatus @default(QUEUED)
  step         SummaryJobStep?
  attempts     Int              @default(0)
  /// User-facing error message only. Never deck text.
  error        String?
  /// Validated AI JSON, kept for the Add company review step (prefill) before a company exists.
  resultJson   Json?
  resultMarkdown String?
  /// Set when the result was written as a Summary version.
  summaryId    String?
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  startedAt    DateTime?
  heartbeatAt  DateTime?
  finishedAt   DateTime?

  @@index([status, createdAt])
  @@index([companyId, status])
}

// ─── History ─────────────────────────────────────────────────────────────────

/// Kept across restores.
model Rejection {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reason           String
  stageAtRejection Stage
  byId             String
  by               User     @relation(fields: [byId], references: [id])
  at               DateTime @default(now())

  @@index([companyId, at])
}

/// Every field change, status change, file upload/remove and summary generate/edit (SPEC §13).
/// companyId null = global change (for example PE team order, sector list).
/// from/to hold display strings, e.g. "P2", "Keyur, Arjun", "12 Mar 2026", or null for empty.
model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  field     String?
  fromValue String?
  toValue   String?
  note      String?
  at        DateTime @default(now())

  @@index([companyId, at])
  @@index([field, at])
}

// ─── Master data ─────────────────────────────────────────────────────────────

model Sector {
  id        String @id @default(cuid())
  name      String @unique
  /// "Other" is seeded with a high value so it always sorts last.
  sortOrder Int

  companies Company[]

  @@index([sortOrder])
}

// ─── WhatsApp intake (SPEC §14) ──────────────────────────────────────────────

enum IntakeStatus {
  PROCESSING
  DONE
  SKIPPED
  FAILED
}

/// One row per WhatsApp document message seen in the group, so each is handled once.
model WhatsAppIntake {
  /// WhatsApp message id
  id           String       @id
  sentAt       DateTime
  senderName   String
  senderNumber String?
  viaName      String?
  fileName     String
  status       IntakeStatus @default(PROCESSING)
  companyId    String?
  /// User-facing reason for SKIPPED / FAILED. Never deck contents.
  error        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
}

/// Small key/value store (e.g. the WhatsApp poll start point).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Written before a hard delete; survives the delete.
model DeletionLog {
  id          String   @id @default(cuid())
  companyName String
  reason      String
  byId        String
  by          User     @relation(fields: [byId], references: [id])
  at          DateTime @default(now())
}

// ─── Portfolio (SPEC §15) ────────────────────────────────────────────────────

/// One investment by Niveshaay into a portfolio company. Amounts in INR crore.
model InvestmentRound {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  /// e.g. Seed, Series A, Pre-IPO
  round       String?
  /// Equity, CCPS, CCD, Convertible note, Other
  instrument  String?
  /// Hedgehogs, Sambhav or Other (null only for rounds entered before funds existed)
  fund        String?
  amount      Decimal  @db.Decimal(14, 2)
  /// Company pre-money valuation for this round, INR crore.
  preMoney    Decimal? @db.Decimal(16, 2)
  /// Stake bought in this round, %.
  stakePct    Decimal? @db.Decimal(7, 4)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([companyId, date])
}


/// Quarterly checklist per portfolio company (replaces the "Team Allocation - Results" sheet). SPEC §15.
/// Each tick is the date it was done (null = not done).
model QuarterCheck {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Indian FY quarter, e.g. "FY27-Q2" (Jul-Sep 2026)
  quarter        String
  misAt          DateTime? @db.Date
  resultNoteAt   DateTime? @db.Date
  remarks        String?
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, quarter])
}

/// Per-quarter settings: the MIS due date (default quarter end + 45 days).
model QuarterSetting {
  quarter   String   @id
  misDue    DateTime @db.Date
  updatedAt DateTime @updatedAt
}

/// Visits, management meetings and calls with portfolio companies, planned and done.
model Meeting {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  /// Plant visit, Management meeting, Quarterly call, Other
  type        String
  /// PLANNED, DONE, CANCELLED
  status      String   @default("PLANNED")
  /// Team members attending (names)
  attendees   String[]
  notes       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([companyId, date])
}
/// Quarterly financials from a company's MIS (or entered by hand), INR crore. One row per company per quarter.
model MisFigure {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// e.g. "FY27-Q2"
  quarter      String
  revenue      Decimal? @db.Decimal(16, 2)
  ebitda       Decimal? @db.Decimal(16, 2)
  pat          Decimal? @db.Decimal(16, 2)
  /// Cash and bank at quarter end
  cash         Decimal? @db.Decimal(16, 2)
  note         String?
  sourceFileId String?
  sourceFile   File?    @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, quarter])
}

/// People to contact at a portfolio company (for MIS / data requests). Several per company, one primary.
model CompanyContact {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

/// News about a portfolio company ("raised Series B", "new plant commissioned"), newest first. SPEC §15.4.
model CompanyUpdate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// When it happened
  date        DateTime @db.Date
  text        String
  /// MANUAL, WHATSAPP, or NEWS / LINKEDIN from the news agent (SPEC §15.10)
  source      String   @default("MANUAL")
  /// News agent: the article or post, its category and importance (high / medium / low)
  url         String?
  category    String?
  importance  String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, date])
}
/// One idle-deal reminder sent to one PE about one company (SPEC §15.7). Drives the 7-then-every-3-days rule.
model ReminderLog {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  idleDays     Int
  sentAt       DateTime   @default(now())

  @@index([companyId, teamMemberId, sentAt])
}

/// Per-day lock so reminders go out once a day even across restarts. `day` = Asia/Kolkata date.
model ReminderRun {
  day   String   @id
  at    DateTime @default(now())
  sent  Int      @default(0)
}

/// What the news agent searches for, per Invested company (SPEC §15.10).
model NewsWatch {
  companyId     String    @id
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Legal and brand names to search for; distinctive enough not to match unrelated news.
  names         String[]
  website       String?
  /// LinkedIn company page, e.g. https://www.linkedin.com/company/kimbal
  linkedinUrl   String?
  enabled       Boolean   @default(true)
  lastCheckedAt DateTime?
  updatedAt     DateTime  @updatedAt
}

/// Every article or post the news agent has seen, once per company, with the AI's verdict (SPEC §15.10).
model NewsItem {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// NEWS or LINKEDIN
  source      String
  url         String
  title       String
  publishedAt DateTime?
  /// MATERIAL, NOT_MATERIAL, NOT_ABOUT, REPEAT, or PENDING (not yet judged, e.g. the AI call failed)
  verdict     String    @default("PENDING")
  category    String?
  importance  String?
  summary     String?
  /// The company update created for a material item
  updateId    String?
  /// Short link code for WhatsApp: APP_URL/n/<code> redirects to `url` (material items only)
  code        String?   @unique
  /// Sent on WhatsApp (one message per material item). digestedAt: unused since messages stopped being clubbed.
  alertedAt   DateTime?
  digestedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([companyId, url])
  @@index([verdict, alertedAt, digestedAt])
}
