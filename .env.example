# Copy to .env and fill in. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL=

# Auth.js
# Public URL of the app in production, e.g. https://pipeline.niveshaay.com (required behind a proxy)
AUTH_URL=
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
ALLOWED_EMAIL_DOMAIN=
# Comma-separated list
ADMIN_EMAILS=

# AI via OpenRouter (paid key with credits; never :free models, see SPEC §13)
OPENROUTER_API_KEY=
# Default: google/gemini-2.5-flash
OPENROUTER_MODEL=

# File storage
# Only "local" is supported for now
STORAGE_DRIVER=
STORAGE_DIR=
# Defaults to 50 when unset
MAX_UPLOAD_MB=

# WhatsApp deck intake via Evolution API v2 (SPEC §14). Leave blank to turn it off.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# The group JID, ending in @g.us
EVOLUTION_Receiver=
# Defaults to 60
WHATSAPP_POLL_SECONDS=

# Optional: path to LibreOffice soffice for PPTX → PDF (the Docker image has it on PATH)
SOFFICE_PATH=

# Local dev only (added in Phase 1, see BUILD_PROMPTS Prompt 1). Must be unset in production.
DEV_LOGIN=
