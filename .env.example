# Copy to .env and fill in. Never commit .env.

# Database (PostgreSQL, e.g. AWS RDS). Wrap DB_PASS in quotes if it contains #.
DB_HOST=
# Defaults to 5432
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
# verify-full (default: encrypted + certificate checked against DB_SSL_CA) | require (encrypted only) | disable
DB_SSL=
# CA bundle for verify-full, default certs/rds-ap-south-1-bundle.pem (AWS RDS Mumbai)
DB_SSL_CA=
# Optional Postgres schema, default public
DB_SCHEMA=

# AI via OpenRouter (paid key with credits; never :free models, see SPEC Â§13)
OPENROUTER_API_KEY=
# Default: google/gemini-2.5-pro (Flash is cheaper but misplaces figures across years)
OPENROUTER_MODEL=

# File storage: S3-compatible bucket. Files are encrypted before upload (SPEC Â§2).
AWS_S3_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
# Folder inside the bucket, no slashes at the ends
AWS_S3_FOLDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, default us-east-1
AWS_REGION=
# 32 random bytes, base64 (openssl rand -base64 32). Keep it safe: without it stored files can't be read.
STORAGE_ENCRYPTION_KEY=
# Optional sub-folder, default "files"
STORAGE_NAMESPACE=
# Defaults to 50 when unset
MAX_UPLOAD_MB=

# WhatsApp deck intake via Evolution API v2 (SPEC Â§14). Leave blank to turn it off.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# The group JID, ending in @g.us
EVOLUTION_Receiver=
# Defaults to 60
WHATSAPP_POLL_SECONDS=
# Portfolio news agent (SPEC 15.10). LinkedIn posts via Apify (Apify > Settings > API & Integrations); blank = news only.
APIFY_TOKEN=
# WhatsApp group JID for portfolio news (e.g. PE Portfolio Updates); blank = no news messages. Never the deck group.
NEWS_WHATSAPP_GROUP=
# The dashboard's public address (e.g. https://pe.example.com): short news links in WhatsApp, APP_URL/n/<code>. Blank = original links.
APP_URL=

# Optional: path to LibreOffice soffice for PPTX â†’ PDF (the Docker image has it on PATH)
SOFFICE_PATH=
